<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conditionals</title>
</head>

<body>
    <%const rand=Math.floor(Math.random() * 10) + 1%>
        <h1>Genreated number is <%= rand %>
        </h1>
        <h1>Number is <%= rand%2===0?'Even':'Odd' %>
        </h1>
</body>

</html>