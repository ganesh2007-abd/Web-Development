<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Farms</title>
</head>

<body>
    <h1>Create new Farm</h1>
    <form action="/farms" method="post">
        <label for="name"> Farm name: </label>
        <input type="text" name="name" id="name" placeholder="Farm name">
        <label for="location"> Farm location: </label>
        <input type="text" name="location" id="location" placeholder="Farm location">
        <label for="email"> Farm name: </label>
        <input type="email" name="email" id="email" placeholder="Farm email">

        <button>Submit</button>
    </form>
</body>

</html>