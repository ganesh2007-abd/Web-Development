<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All farms</title>
</head>

<body>
    <%= messages %>
        <h1>All the Farms:</h1>
        <ul>
            <%for(let farm of farms) {%>
                <li>
                    <a href="/farms/<%= farm._id %>">
                        <%= farm.name %>
                    </a>
                </li>
                <%} %>
        </ul>
        <a href="/farms/new">New farm</a>
        <a href="/products">All products</a>
</body>

</html>