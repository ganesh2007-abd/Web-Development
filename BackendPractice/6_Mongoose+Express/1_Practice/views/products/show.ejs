<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.name %>
    </title>
</head>

<body>
    <h1>
        <%= product.name %>
    </h1>
    <ul>
        <li>
            Price:
            <%= product.price %> rs
        </li>
        <li>
            Category:
            <%= product.category %>
        </li>
        <a href="/farms/<%= product.farm._id %>">
            <%= product.farm.name %>
        </a>
    </ul>
    <a href="/farms/<%= product.farm._id %>">Back to farm</a>
    <form action="/products/<%=product._id%>?_method=DELETE" method="post">
        <button>Delete</button>
    </form>
</body>

</html>