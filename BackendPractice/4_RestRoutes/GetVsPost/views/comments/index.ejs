<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h1><b>Index Route</b></h1>
    <h1>All Comments</h1>
    <ul>
        <% for(let comment of comments){ %>
            <li>
                <%= comment.text%> - <b>
                        <%= comment.user%>
                    </b>
                    <a href="/comments/<%= comment.id %>">Details</a>
            </li>
            <% } %>
    </ul>
    <a href="/comments/new/">New Comment</a>
</body>

</html>